	whose (version of it &gt; "1" AND size of it = "big")</Relevance>
		<Relevance>exists totally bogus made up inspector
	whose (it is true)</Relevance>
		<Relevance>name of it
	as lowercase</Relevance>
		<Relevance>(exists file "a" AND
	exists file "b"</Relevance>
		<Relevance>exists file "unterminated</Relevance>
		<Category>Contract</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-08</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 08 Oct 2026 00:00:00 +0000</Value>
