{
  "name": "bigfix-relevance-developer",
  "displayName": "BigFix Relevance Developer",
  "description": "Live diagnostics, hover, completion and syntax highlighting for BigFix Relevance and ActionScript in fixlets, tasks, analyses, dashboards, .rel files and Markdown.",
  "version": "0.0.1",
  "private": true,
  "publisher": "jgstew",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgstew/bigfix-relevance-analyzer"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "bigfix",
    "relevance",
    "actionscript",
    "fixlet",
    "bes"
  ],
  "engines": {
    "vscode": "^1.91.0",
    "npm": ">=11.10.0"
  },
  "main": "./extension.js",
  "settingsPrefix": "bigfixRelevance",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bigfixRelevance.restartServer",
        "title": "BigFix Relevance: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "bigfix-relevance",
        "aliases": [
          "BigFix Relevance",
          "bigfix-relevance"
        ],
        "extensions": [
          ".rel",
          ".bsr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bigfix-actionscript",
        "aliases": [
          "BigFix ActionScript",
          "bigfix-actionscript"
        ],
        "extensions": [
          ".actionscript"
        ],
        "configuration": "./language-configuration-actionscript.json"
      },
      {
        "id": "bigfix-bes",
        "aliases": [
          "BigFix BES XML",
          "bigfix-bes"
        ],
        "extensions": [
          ".bes",
          ".bes.xml"
        ],
        "configuration": "./language-configuration-bes.json"
      }
    ],
    "grammars": [
      {
        "language": "bigfix-relevance",
        "scopeName": "source.bigfix-relevance",
        "path": "./syntaxes/bigfix-relevance.tmLanguage.json"
      },
      {
        "scopeName": "markdown.bigfix-relevance.codeblock",
        "path": "./syntaxes/markdown-relevance.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bigfix-relevance": "bigfix-relevance"
        }
      },
      {
        "language": "bigfix-actionscript",
        "scopeName": "source.bigfix-actionscript",
        "path": "./syntaxes/bigfix-actionscript.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.bigfix-relevance": "bigfix-relevance"
        }
      },
      {
        "language": "bigfix-bes",
        "scopeName": "text.xml.bigfix-bes",
        "path": "./syntaxes/bigfix-bes.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.bigfix-actionscript": "bigfix-actionscript",
          "meta.embedded.block.bigfix-relevance": "bigfix-relevance",
          "meta.embedded.line.bigfix-relevance": "bigfix-relevance"
        }
      }
    ],
    "configuration": {
      "title": "BigFix Relevance Developer",
      "properties": {
        "bigfixRelevance.maxDocumentBytes": {
          "type": "integer",
          "minimum": 0,
          "default": 1048576,
          "description": "Documents larger than this (UTF-8 bytes) are not linted; they get one informational diagnostic instead."
        },
        "bigfixRelevance.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the LSP messages between VS Code and the server to the extension's output channel."
        }
      }
    }
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.26.0",
    "vscode-jsonrpc": "9.0.3",
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.35.0",
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
