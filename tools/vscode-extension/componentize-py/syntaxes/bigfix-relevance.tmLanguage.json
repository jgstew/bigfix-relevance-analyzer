{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BigFix Relevance",
  "scopeName": "source.bigfix-relevance",
  "comment": "Generated by tools/generate_tmlanguage.py; do not edit by hand.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#word-operator"
    },
    {
      "include": "#structural"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#punctuation-operator"
    },
    {
      "include": "#separator"
    },
    {
      "include": "#paren"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.bigfix-relevance",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string": {
      "name": "string.quoted.double.bigfix-relevance",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bigfix-relevance",
          "match": "%[0-9A-Fa-f]{2}"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.integer.bigfix-relevance",
      "match": "\\b[0-9]+\\b"
    },
    "word-operator": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.bigfix-relevance",
          "match": "(?i)\\b(?:mod)\\b"
        },
        {
          "name": "keyword.operator.comparison.bigfix-relevance",
          "match": "(?i)\\b(?:is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*greater\\s+(?:(?:a|an|the)\\s+)*than\\s+(?:(?:a|an|the)\\s+)*or\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*less\\s+(?:(?:a|an|the)\\s+)*than\\s+(?:(?:a|an|the)\\s+)*or\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|is\\s+(?:(?:a|an|the)\\s+)*greater\\s+(?:(?:a|an|the)\\s+)*than\\s+(?:(?:a|an|the)\\s+)*or\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|is\\s+(?:(?:a|an|the)\\s+)*less\\s+(?:(?:a|an|the)\\s+)*than\\s+(?:(?:a|an|the)\\s+)*or\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|does\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*start\\s+(?:(?:a|an|the)\\s+)*with|is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*contained\\s+(?:(?:a|an|the)\\s+)*by|is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*greater\\s+(?:(?:a|an|the)\\s+)*than|does\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*end\\s+(?:(?:a|an|the)\\s+)*with|does\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*contain|is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*less\\s+(?:(?:a|an|the)\\s+)*than|is\\s+(?:(?:a|an|the)\\s+)*contained\\s+(?:(?:a|an|the)\\s+)*by|is\\s+(?:(?:a|an|the)\\s+)*greater\\s+(?:(?:a|an|the)\\s+)*than|is\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|does\\s+(?:(?:a|an|the)\\s+)*not\\s+(?:(?:a|an|the)\\s+)*equal|is\\s+(?:(?:a|an|the)\\s+)*less\\s+(?:(?:a|an|the)\\s+)*than|is\\s+(?:(?:a|an|the)\\s+)*equal\\s+(?:(?:a|an|the)\\s+)*to|starts\\s+(?:(?:a|an|the)\\s+)*with|ends\\s+(?:(?:a|an|the)\\s+)*with|contains|equals|is\\s+(?:(?:a|an|the)\\s+)*not|is)\\b"
        },
        {
          "name": "keyword.operator.logical.bigfix-relevance",
          "match": "(?i)\\b(?:and|or)\\b"
        }
      ]
    },
    "structural": {
      "patterns": [
        {
          "name": "keyword.control.conditional.bigfix-relevance",
          "match": "(?i)\\b(?:else|then|if)\\b"
        },
        {
          "name": "keyword.control.filter.bigfix-relevance",
          "match": "(?i)\\b(?:whose)\\b"
        },
        {
          "name": "keyword.operator.cast.bigfix-relevance",
          "match": "(?i)\\b(?:as)\\b"
        },
        {
          "name": "keyword.operator.logical.bigfix-relevance",
          "match": "(?i)\\b(?:exists|exist|not)\\b"
        },
        {
          "name": "keyword.operator.of.bigfix-relevance",
          "match": "(?i)\\b(?:of)\\b"
        },
        {
          "name": "variable.language.it.bigfix-relevance",
          "match": "(?i)\\b(?:it)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.bigfix-relevance",
      "match": "(?i)\\b(?:false|true)\\b"
    },
    "punctuation-operator": {
      "name": "keyword.operator.bigfix-relevance",
      "match": "!=|<=|>=|\\&|\\*|\\+|\\-|/|<|=|>|\\|"
    },
    "separator": {
      "name": "punctuation.separator.bigfix-relevance",
      "match": "[;,]"
    },
    "paren": {
      "name": "punctuation.section.parens.bigfix-relevance",
      "match": "[()]"
    }
  }
}
