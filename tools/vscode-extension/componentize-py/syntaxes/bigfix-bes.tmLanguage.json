{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BigFix BES XML",
  "scopeName": "text.xml.bigfix-bes",
  "comment": "Generated by tools/generate_tmlanguage.py; do not edit by hand.",
  "patterns": [
    {
      "include": "#actionscript"
    },
    {
      "include": "#relevance"
    },
    {
      "include": "text.xml"
    }
  ],
  "repository": {
    "actionscript": {
      "begin": "(<)(ActionScript)(?=[\\s>/]|$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.localname.xml"
        }
      },
      "end": "(</)(ActionScript)\\s*(>)|(?<=/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.localname.xml"
        },
        "3": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "patterns": [
        {
          "include": "#actionscript-other-language"
        },
        {
          "include": "#actionscript-self-closing"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#actionscript-body"
        }
      ]
    },
    "actionscript-other-language": {
      "begin": "\\b(MIMEType)\\s*(=)\\s*(\\\"(?!(?i:application/x\\-fixlet\\-windows\\-shell)\\\")[^\\\"]*\\\"|'(?!(?i:application/x\\-fixlet\\-windows\\-shell)')[^']*')",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.localname.xml"
        },
        "2": {
          "name": "punctuation.separator.key-value.xml"
        },
        "3": {
          "name": "string.quoted.xml"
        }
      },
      "end": "(?=</ActionScript\\s*>)",
      "patterns": [
        {
          "include": "text.xml"
        }
      ]
    },
    "actionscript-self-closing": {
      "name": "punctuation.definition.tag.xml",
      "match": "/>"
    },
    "actionscript-body": {
      "begin": "(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "end": "(?=</ActionScript\\s*>)",
      "contentName": "meta.embedded.block.bigfix-actionscript",
      "patterns": [
        {
          "include": "#cdata-actionscript"
        },
        {
          "include": "#entity"
        },
        {
          "include": "source.bigfix-actionscript"
        }
      ]
    },
    "cdata-actionscript": {
      "begin": "<!\\[CDATA\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.xml"
        }
      },
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.xml"
        }
      },
      "patterns": [
        {
          "include": "source.bigfix-actionscript"
        }
      ]
    },
    "relevance": {
      "begin": "(<)((?:Relevance|Property|SuccessCriteria(?=\\s)(?=(?:\"[^\"]*\"|'[^']*'|[^>\"'])*?\\bOption\\s*=\\s*(?:\\\"CustomRelevance\\\"|'CustomRelevance')))(?=[\\s>]))((?:\\s(?:\"[^\"]*\"|'[^']*'|[^>\"'])*)?)(?<!/)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.localname.xml"
        },
        "3": {
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "end": "(</)(\\2)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.localname.xml"
        },
        "3": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "contentName": "meta.embedded.block.bigfix-relevance",
      "patterns": [
        {
          "include": "#cdata-relevance"
        },
        {
          "include": "#entity"
        },
        {
          "include": "#relevance-body"
        }
      ]
    },
    "relevance-body": {
      "patterns": [
        {
          "name": "string.quoted.double.bigfix-relevance",
          "begin": "\"",
          "end": "\"|(?=</(?:Relevance|Property|SuccessCriteria)\\s*>|\\]\\]>)",
          "patterns": [
            {
              "name": "constant.character.escape.bigfix-relevance",
              "match": "%[0-9A-Fa-f]{2}"
            }
          ]
        },
        {
          "name": "comment.block.bigfix-relevance",
          "begin": "/\\*",
          "end": "\\*/|(?=</(?:Relevance|Property|SuccessCriteria)\\s*>|\\]\\]>)"
        },
        {
          "include": "source.bigfix-relevance"
        }
      ]
    },
    "cdata-relevance": {
      "begin": "<!\\[CDATA\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.xml"
        }
      },
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.xml"
        }
      },
      "patterns": [
        {
          "include": "#relevance-body"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "([-\\w.:]+)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.localname.xml"
            },
            "2": {
              "name": "punctuation.separator.key-value.xml"
            }
          }
        },
        {
          "name": "string.quoted.double.xml",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.xml",
          "match": "'[^']*'"
        }
      ]
    },
    "entity": {
      "name": "constant.character.entity.xml",
      "match": "&(?:[A-Za-z_:][\\w:.-]*|#[0-9]+|#x[0-9A-Fa-f]+);"
    }
  }
}
